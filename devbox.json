{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "prek@latest",
    "gh@latest"
  ],
  "shell": {
    "init_hook": [
      "prek install"
    ],
    "scripts": {
      "install-hooks": [
        "prek install"
      ],
      "test": [
        "cargo test"
      ],
      "test-all": [
        "cargo test --workspace"
      ],
      "clippy": [
        "cargo clippy --workspace --all-targets --locked -- -D warnings"
      ],
      "check": [
        "cargo fmt --all --check",
        "cargo clippy --workspace --all-targets --locked -- -D warnings"
      ]
    }
  }
}
