{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "prek@latest",
    "gh@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "install-hooks": [
        "prek install"
      ],
      "test": [
        "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://$USER@127.0.0.1/postgres} cargo test --workspace --locked",
        "(cd browser-tests && npm ci && npm run install:browsers)",
        "./browser-tests/run.sh"
      ],
      "check": [
        "cargo fmt --all --check",
        "cargo clippy --workspace --all-targets --locked -- -D warnings",
        "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://$USER@127.0.0.1/postgres} cargo test --workspace --locked",
        "./qualification/adjudication-engine/run.sh",
        "(cd browser-tests && npm ci && npm run install:browsers)",
        "./browser-tests/run.sh"
      ]
    }
  }
}
